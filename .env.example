# 1) Copy this file to a file named exactly  .env  (same folder as docker-compose.yml)
# 2) docker compose down && docker compose up --build
# Check: http://localhost:4000/api/health  should show "ok":true

# Required: long random string used to sign login tokens (e.g. run: openssl rand -hex 32)
JWT_SECRET=
# Optional: password for the admin account (admin@smartfix.com). No admin is created if empty.
ADMIN_PASSWORD=
# Set to true only for local demos: seeds demo accounts with the public password demo123
SEED_DEMO=false
# URL the browser uses to reach the API (change for a hosted deployment)
VITE_API_URL=http://localhost:4000/api
